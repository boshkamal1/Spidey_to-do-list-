rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/planner/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /widgetFeeds/{feedId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'day', 'updatedAt', 'tasks', 'taskIds']);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'day', 'updatedAt', 'tasks', 'taskIds']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /completions/{taskId} {
        allow get: if true;
        allow list: if request.auth != null
          && get(/databases/$(database)/documents/widgetFeeds/$(feedId)).data.ownerUid == request.auth.uid;
        allow create, update: if request.resource.data.keys().hasOnly(['done'])
          && request.resource.data.keys().hasAll(['done'])
          && request.resource.data.done is bool
          && get(/databases/$(database)/documents/widgetFeeds/$(feedId)).data.taskIds.hasAny([taskId]);
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/widgetFeeds/$(feedId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
